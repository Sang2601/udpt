{
  "name": "webnc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"GW,AUTH,HOTEL,BOOK1,BOOK2,NOTIF,UI\" -c \"magenta,blue,cyan,green,yellow,red,white\" \"node gateway/src/index.js\" \"node services/auth/src/index.js\" \"node services/hotel/src/index.js\" \"cross-env PORT=5003 SERVICE_INSTANCE_ID=booking-replica-1 node services/booking/src/index.js\" \"cross-env PORT=5004 SERVICE_INSTANCE_ID=booking-replica-2 node services/booking/src/index.js\" \"node services/notification/src/index.js\" \"vite\"",
    "gateway": "node gateway/src/index.js",
    "auth": "node services/auth/src/index.js",
    "hotel": "node services/hotel/src/index.js",
    "booking1": "cross-env PORT=5003 SERVICE_INSTANCE_ID=booking-replica-1 node services/booking/src/index.js",
    "booking2": "cross-env PORT=5004 SERVICE_INSTANCE_ID=booking-replica-2 node services/booking/src/index.js",
    "notification": "node services/notification/src/index.js",
    "client": "vite",
    "test": "node tests/run_all_tests.js",
    "test:chord": "node tests/chord.test.js",
    "test:worker": "node tests/worker_pool.test.js",
    "test:rpc": "node tests/json_rpc.test.js",
    "test:concurrency": "node tests/concurrency_overbooking.test.js",
    "test:rollback": "node tests/multi_night_rollback.test.js",
    "test:idempotency": "node tests/idempotency.test.js",
    "test:cancellation": "node tests/cancellation_idempotency.test.js",
    "chord:demo": "node examples/chord/chord-cli.js",
    "migrate:sqlite": "node infra/migration/sqlite_to_cockroach.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
