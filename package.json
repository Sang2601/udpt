{
  "name": "phenikaa-hotel-distributed",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"GATEWAY,AUTH,USER,ROOM1,ROOM2,BOOK1,BOOK2,PAYMENT,UI\" -c \"magenta,red,blue,green,green.dim,yellow,yellow.dim,cyan,white\" \"node gateway/src/index.js\" \"node services/auth/src/index.js\" \"node services/user/src/index.js\" \"cross-env PORT=8083 SERVICE_INSTANCE_ID=room-replica-1 node services/room/src/index.js\" \"cross-env PORT=8086 SERVICE_INSTANCE_ID=room-replica-2 node services/room/src/index.js\" \"cross-env PORT=8082 SERVICE_INSTANCE_ID=booking-replica-1 node services/booking/src/index.js\" \"cross-env PORT=8085 SERVICE_INSTANCE_ID=booking-replica-2 node services/booking/src/index.js\" \"node services/payment/src/index.js\" \"vite\"",
    "gateway": "node gateway/src/index.js",
    "auth": "node services/auth/src/index.js",
    "user": "node services/user/src/index.js",
    "room1": "cross-env PORT=8083 SERVICE_INSTANCE_ID=room-replica-1 node services/room/src/index.js",
    "room2": "cross-env PORT=8086 SERVICE_INSTANCE_ID=room-replica-2 node services/room/src/index.js",
    "booking1": "cross-env PORT=8082 SERVICE_INSTANCE_ID=booking-replica-1 node services/booking/src/index.js",
    "booking2": "cross-env PORT=8085 SERVICE_INSTANCE_ID=booking-replica-2 node services/booking/src/index.js",
    "payment": "node services/payment/src/index.js",
    "client": "vite",
    "test:load": "node scripts/load-test.js",
    "test:failover": "node scripts/failover-test.js",
    "backup": "node scripts/backup-databases.js",
    "restore": "node scripts/restore-databases.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
