# ==============================================================================
# PhenikaaHotel Distributed Microservices Environment Variables (.env.example)
# Note: For local development and demonstration only.
# ==============================================================================

# API Gateway Configuration
GATEWAY_PORT=5000
AUTH_SERVICE_URL=http://localhost:5001
HOTEL_SERVICE_URL=http://localhost:5002
BOOKING_REPLICAS=http://localhost:5003,http://localhost:5004
NOTIFICATION_SERVICE_URL=http://localhost:5005

# Auth Service
AUTH_PORT=5001
AUTH_DB_URL=postgresql://auth_user:auth_secure_pass_2026@localhost:26250/auth_db?sslmode=disable
JWT_SECRET=super_secret_jwt_key_phenikaa_hotel_2026

# Hotel Service
HOTEL_PORT=5002
HOTEL_DB_URL=postgresql://hotel_user:hotel_secure_pass_2026@localhost:26250/hotel_db?sslmode=disable

# Booking Service
BOOKING_PORT=5003
BOOKING_DB_URL=postgresql://booking_user:booking_secure_pass_2026@localhost:26250/booking_db?sslmode=disable
HOTEL_RPC_URL=http://localhost:5002/rpc

# Notification Service
NOTIFICATION_PORT=5005
NOTIFICATION_DB_URL=postgresql://notification_user:notif_secure_pass_2026@localhost:26250/notification_db?sslmode=disable

# RabbitMQ
RABBITMQ_URL=amqp://hotel_rabbit:rabbit_secure_pass_2026@localhost:5672

# CockroachDB Cluster Node Ports
ROACH1_SQL_PORT=26257
ROACH2_SQL_PORT=26258
ROACH3_SQL_PORT=26259
HAPROXY_SQL_PORT=26250
